# ==============================================================================
# Newtonite Operations Engine - Backend Environment Variables
# ==============================================================================

# Database Connection URL:
# Local Development (SQLite WAL mode):
DATABASE_URL=sqlite+aiosqlite:///./newtonite.db

# Supabase Production PostgreSQL (IPv4 Session Pooler URI on Port 5432):
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql+asyncpg://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Allowed CORS Origins (comma-separated or *):
# Production example: https://newtonite.pages.dev,http://localhost:5173
CORS_ORIGINS=*

# Server Port (automatically injected by Koyeb/Heroku/Render):
PORT=8000
