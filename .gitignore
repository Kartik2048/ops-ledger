*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/newtonite.db
backend/newtonite.db-shm
backend/newtonite.db-wal

# Node.js & Frontend Dependencies / Bundles
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
